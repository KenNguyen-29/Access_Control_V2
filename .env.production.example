# Copy to .env on the server before: docker compose -f docker-compose.prod.yml up -d --build
# No server/LAN IP is embedded here. The web container proxies same-origin
# requests to the API service. Leave API_PUBLIC_URL blank for per-device
# Windows route selection; set it only for one stable VPN/reverse-proxy URL
# reachable by every panel.

POSTGRES_USER=acv2
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=access_control_v2

MINIO_ACCESS_KEY=acv2minio
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET=acv2-assets

JWT_SECRET=change-me-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=true
ENABLE_HSTS=false
# First admin when DB has no account. Change after first login.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=admin123

# Attendance / shift math uses Asia/Ho_Chi_Minh in code; set TZ for process-local helpers too.
TZ=Asia/Ho_Chi_Minh

# Host ports (container web=3000, api=8080 internally)
WEB_HOST_PORT=3003
API_HOST_PORT=8010
API_PUBLIC_URL=
PUBLIC_HOST=
PUBLIC_PROTOCOL=http
CORS_ORIGIN=
# Browser calls remain same-origin; Next.js proxies to the compose API service.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
API_PROXY_TARGET=http://api:8080

# Redis runs in docker-compose.prod (same network as API)
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Set false when connecting to real Akuvox panels on LAN
AKUVOX_MOCK_MODE=true

# DNAKE S414L — set DNAKE_MOCK_MODE=false when talking to a real panel
DNAKE_MOCK_MODE=true
DNAKE_REQUEST_TIMEOUT=15000
DNAKE_POLL_ENABLED=false
# Username/password: per device in UI (Devices). Do not use shared env defaults.

PUNCH_COOLDOWN_MINUTES=5

# go2rtc — compose forces http://go2rtc:1984 (same Docker network). Do not use 127.0.0.1.
GO2RTC_BASE_URL=http://go2rtc:1984
GO2RTC_ENABLED=true
GO2RTC_AUTO_START=false
# Keep the camera simulator disabled in production.
MOCK_CAMERA_ENABLED=false
MOCK_CAMERA_IP=192.168.1.4
MOCK_CAMERA_SOURCE=http://127.0.0.1:19084/stream.mjpeg
MOCK_CAMERA_USERNAME=
MOCK_CAMERA_PASSWORD=
RTSP_WARM_BUFFER_ENABLED=true
RTSP_WARM_FFMPEG_TEMPLATE=mjpeg_fps
RTSP_WARM_BUFFER_MS=3000
RTSP_WARM_MAX_FRAME_AGE_MS=5000
RTSP_WARM_MIN_JPEG_BYTES=16000
