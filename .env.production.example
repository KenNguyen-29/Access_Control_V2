# Copy to .env on the server before: docker compose -f docker-compose.prod.yml up -d --build
# Replace 192.168.2.148 with this machine's LAN IP if different.

POSTGRES_USER=acv2
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=access_control_v2

MINIO_ACCESS_KEY=acv2minio
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET=acv2-assets

JWT_SECRET=change-me-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Host ports (container web=3000, api=8080 internally)
# Replace 192.168.2.148 with this VM's LAN IP
WEB_HOST_PORT=3003
API_HOST_PORT=8010
API_PUBLIC_URL=http://192.168.2.148:8010
CORS_ORIGIN=http://192.168.2.148:3003
NEXT_PUBLIC_API_URL=http://192.168.2.148:8010/api
NEXT_PUBLIC_WS_URL=http://192.168.2.148:8010

# Redis runs in docker-compose.prod (same network as API)
REDIS_ENABLED=true

# Set false when connecting to real Akuvox panels on LAN
AKUVOX_MOCK_MODE=true
AKUVOX_DEFAULT_USERNAME=admin
AKUVOX_DEFAULT_PASSWORD=change-me

PUNCH_COOLDOWN_MINUTES=5

# go2rtc for camera WebRTC — install on host separately if needed
GO2RTC_BASE_URL=http://127.0.0.1:1984
GO2RTC_ENABLED=false
GO2RTC_AUTO_START=false
