# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://acv2:acv2secret@localhost:5432/access_control_v2?schema=public

# ── Redis (cache + BullMQ) ────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── MinIO (S3-compatible — snapshots / optional assets) ───
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=acv2minio
MINIO_SECRET_KEY=acv2minio123
MINIO_BUCKET=acv2-assets

# FaceID local disk (PostgreSQL stores relative path only) ─
# Default: apps/api/uploads when running from apps/api cwd
FACE_UPLOAD_DIR=./uploads
# Optional common public URL for FaceID files and Akuvox callbacks. Leave empty
# for automatic routing: per-device FaceURL/webhook picks the local address
# selected by Windows for that panel's LAN/VPN route. Set this only when a
# reverse proxy/NAT exposes one stable hostname that every device can call.
API_PUBLIC_URL=
# Optional fallback host/protocol for deployments without a target device or
# when the VPN publishes one known server address.
PUBLIC_HOST=
PUBLIC_PROTOCOL=http
# Optional browser-only URL for a split-origin deployment.
# API_BROWSER_URL=

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-long-random-string
# Access token short-lived (10–15m recommended)
JWT_EXPIRES_IN=15m
# Refresh token lifetime (HttpOnly cookie)
JWT_REFRESH_EXPIRES_IN=7d
# Set true only behind working HTTPS so refresh cookies are Secure
COOKIE_SECURE=false
# First admin when DB has no account yet (pnpm db:seed / deploy bootstrap).
# Defaults: admin / admin123 — must change password after first login.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=admin123
# Only enable after TLS is live (reverse proxy / cert)
ENABLE_HSTS=false

# ── go2rtc (RTSP → WebRTC, runs on host) ───────────────────
# Install once: pnpm --filter @acv2/api go2rtc:install
GO2RTC_BASE_URL=http://127.0.0.1:1984
GO2RTC_ENABLED=true
GO2RTC_AUTO_START=true
GO2RTC_TIMEOUT_MS=15000
# GO2RTC_BINARY_PATH=  # optional: absolute path to go2rtc(.exe); defaults to apps/api/bin

# Keep RTSP decoded and retain recent JPEG frames for event-time snapshots.
RTSP_WARM_BUFFER_ENABLED=true
RTSP_WARM_FFMPEG_TEMPLATE=mjpeg_fps
RTSP_WARM_BUFFER_MS=3000
RTSP_WARM_MAX_FRAME_AGE_MS=5000
RTSP_WARM_MIN_JPEG_BYTES=16000
RTSP_WARM_RECONCILE_MS=15000
RTSP_WARM_RESTART_MS=3000
SNAPSHOT_MIN_JPEG_BYTES=20000

# ── ONVIF (native Windows; no sidecar/token required) ─────
ONVIF_SCAN_TIMEOUT_MS=5000
ONVIF_PROFILE_TIMEOUT_MS=15000

# ── Local camera simulator (opt-in, development only) ─────
# Keeps 192.168.1.4 in the device record but redirects its RTSP source to the
# mock MJPEG server started by tools/simulate-akuvox.ps1.
MOCK_CAMERA_ENABLED=false
MOCK_CAMERA_IP=192.168.1.4
# For a real source, set the RTSP URL (the virtual IP in the device record is
# still 192.168.1.4), e.g. rtsp://192.168.1.4:554/rtsp/streaming?... .
# Leave the HTTP value for the generated local test pattern.
MOCK_CAMERA_SOURCE=http://127.0.0.1:19084/stream.mjpeg
# Optional only when MOCK_CAMERA_SOURCE is an RTSP URL without credentials.
MOCK_CAMERA_USERNAME=
MOCK_CAMERA_PASSWORD=

# ── API server ────────────────────────────────────────────
API_PORT=8010
API_BIND_HOST=0.0.0.0
# Comma-separated allow-list. Leave empty for adaptive same-origin/local deployments.
CORS_ORIGIN=

# ── Next.js web ───────────────────────────────────────────
# Empty means the browser uses its current origin (/api and Socket.IO proxy).
# Set these only when FE and API intentionally use different origins.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
# Next.js server-side proxy target (native default: http://127.0.0.1:8010).
API_PROXY_TARGET=http://127.0.0.1:8010

# ── Akuvox outbound API ───────────────────────────────────
# Set false when syncing to a real panel
AKUVOX_MOCK_MODE=false
# Username/password: cấu hình trên từng thiết bị trong UI (Thiết bị), không dùng biến env chung.
AKUVOX_REQUEST_TIMEOUT=15000
# Optional inbound webhook security (door_log)
# AKUVOX_WEBHOOK_TOKEN=
# AKUVOX_ALLOWED_IPS=192.168.71.186

# ── DNAKE S414L (poll unlock logs ~10s) ────────────────────
DNAKE_MOCK_MODE=true
DNAKE_REQUEST_TIMEOUT=15000
DNAKE_POLL_ENABLED=false

# ── Attendance punch rules ──────────────────────────────────
# Minimum minutes between check-in and a counted check-out scan
PUNCH_COOLDOWN_MINUTES=5

# ── Redis connection (BullMQ) ─────────────────────────────
# Local/dev (ổn định với nest --watch): REDIS_ENABLED=false → webhook xử lý sync, không backlog khi API restart.
# Prod / nhiều request: REDIS_ENABLED=true → queue BullMQ; theo dõi queue.waiting trên Dashboard Realtime / GET /api/health.
# Khi test quét mặt realtime: mở /dashboard và giữ badge Socket Online.
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
