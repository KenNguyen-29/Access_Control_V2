# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://acv2:acv2secret@localhost:5432/access_control_v2?schema=public

# ── Redis (cache + BullMQ) ────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── MinIO (S3-compatible — snapshots / optional assets) ───
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=acv2minio
MINIO_SECRET_KEY=acv2minio123
MINIO_BUCKET=acv2-assets

# ── FaceID local disk (PostgreSQL stores relative path only) ─
# Default: apps/api/uploads when running from apps/api cwd
FACE_UPLOAD_DIR=./uploads
# URL devices/FE use to fetch face JPG (must be reachable by Akuvox)
API_PUBLIC_URL=http://localhost:8080

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d

# ── go2rtc (RTSP → WebRTC, runs on host) ───────────────────
# Install once: pnpm --filter @acv2/api go2rtc:install
GO2RTC_BASE_URL=http://127.0.0.1:1984
GO2RTC_ENABLED=true
GO2RTC_AUTO_START=true
GO2RTC_TIMEOUT_MS=15000
# GO2RTC_BINARY_PATH=  # optional: absolute path to go2rtc(.exe); defaults to apps/api/bin

# ── API server ────────────────────────────────────────────
API_PORT=8080
CORS_ORIGIN=http://localhost:3000

# ── Next.js web ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_WS_URL=http://localhost:8080

# ── Akuvox outbound API ───────────────────────────────────
AKUVOX_MOCK_MODE=true
AKUVOX_DEFAULT_USERNAME=admin
AKUVOX_DEFAULT_PASSWORD=admin
AKUVOX_REQUEST_TIMEOUT=5000

# ── Redis connection (BullMQ) ─────────────────────────────
# Set REDIS_ENABLED=false for local dev without Redis (webhook runs sync)
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
