{
  "name": "@acv2/api",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "node prisma/run-seed.cjs"
  },
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/modules/attendance/attendance-calculation.util.test.ts src/modules/attendance/attendance.service.punch.test.ts src/modules/shifts/shift-time.util.test.ts src/modules/users/users-excel.util.test.ts src/modules/devices/onvif-discovery.service.test.ts src/modules/devices/devices.onvif.test.ts src/modules/devices/device-webrtc.service.test.ts src/modules/devices/utils/rtsp-url.util.test.ts src/modules/devices/utils/mock-camera.util.test.ts src/modules/queue/rtsp-frame-buffer.util.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node --project tsconfig.seed.json prisma/seed.ts",
    "prisma:seed:demo": "ts-node --project tsconfig.seed.json prisma/seed-attendance-demo.ts",
    "prisma:seed:contractors": "ts-node --project tsconfig.seed.json prisma/seed-contractor-demo.ts",
    "prisma:seed:scale": "tsx --tsconfig tsconfig.seed.json prisma/seed-project-contractor-demo.ts",
    "prisma:seed:bulk": "ts-node --project tsconfig.seed.json prisma/seed-bulk-users.ts",
    "prisma:seed:sample20": "ts-node --project tsconfig.seed.json prisma/seed-sample-20.ts",
    "prisma:studio": "prisma studio",
    "simulator:camera": "node scripts/mock-akuvox-camera.mjs",
    "simulator:setup": "tsx --tsconfig tsconfig.seed.json scripts/setup-akuvox-simulator.ts",
    "go2rtc:install": "powershell -ExecutionPolicy Bypass -File scripts/install-go2rtc.ps1"
  },
  "dependencies": {
    "@acv2/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/websockets": "^10.4.15",
    "@prisma/client": "^6.3.1",
    "axios": "^1.18.1",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.34.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cron": "^4.4.0",
    "exceljs": "^4.4.0",
    "express": "^4.22.1",
    "ioredis": "^5.4.2",
    "jszip": "^3.10.1",
    "onvif": "0.8.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/bcrypt": "^5.0.2",
    "@types/cron": "^2.4.3",
    "@types/exceljs": "^1.3.2",
    "@types/express": "^5.0.0",
    "@types/jszip": "^3.4.1",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^6.3.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3"
  }
}
